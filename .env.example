# Flask Application Configuration
SECRET_KEY=your-secret-key-here

# Database Configuration: Neon PostgreSQL (Production/Cloud) with SQLite Local Fallback
# Copy your connection string from the Neon Console (https://console.neon.tech)
# Example: postgresql://neondb_owner:npg_xyz@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require


# Email Notification Configuration (SMTP / Gmail)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
